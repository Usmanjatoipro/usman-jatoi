<script id="elementor-frontend-js-after">
(function() {
            "use strict";
            
            function initWbbBorderEffects() {
                // Initialize Rainbow borders
                document.querySelectorAll("[data-wbb-rainbow=\"true\"]").forEach(function(el) {
                    var speed = el.dataset.wbbRainbowSpeed || 5;
                    var width = el.dataset.wbbRainbowWidth || 2;
                    var blur = el.dataset.wbbRainbowBlur || 25;
                    
                    el.style.setProperty("--wbb-rainbow-speed", speed + "s");
                    el.style.setProperty("--wbb-rainbow-width", width);
                    el.style.setProperty("--wbb-rainbow-blur", blur + "px");
                });
                
                // Initialize Tracking borders
                document.querySelectorAll("[data-wbb-tracking=\"true\"]").forEach(function(el) {
                    if (el.querySelector(".wbb-tracking-svg")) return; // Already initialized
                    
                    var color = el.dataset.wbbTrackingColor || "#00ff00";
                    var width = el.dataset.wbbTrackingWidth || 2;
                    var radius = el.dataset.wbbTrackingRadius || 80;
                    var uniqueId = "wbb-track-" + Math.random().toString(36).substr(2, 9);
                    
                    // Get computed border radius
                    var computedStyle = window.getComputedStyle(el);
                    var borderRadius = computedStyle.borderRadius || "0";
                    var rx = parseInt(borderRadius) || 0;
                    
                    // Create SVG
                    var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                    svg.setAttribute("class", "wbb-tracking-svg");
                    svg.setAttribute("width", "100%");
                    svg.setAttribute("height", "100%");
                    
                    svg.innerHTML = \`
                        <defs>
                            <radialGradient id="\${uniqueId}" cx="50%" cy="50%" r="\${radius}%" fx="50%" fy="50%">
                                <stop offset="0%" stop-color="\${color}" stop-opacity="1"/>
                                <stop offset="100%" stop-color="\${color}" stop-opacity="0"/>
                            </radialGradient>
                        </defs>
                        <rect class="wbb-tracking-rect" x="0" y="0" width="100%" height="100%" 
                              rx="\${rx}" ry="\${rx}" fill="none" 
                              stroke="url(#\${uniqueId})" stroke-width="\${width}" opacity="0"/>
                    \`;
                    
                    el.appendChild(svg);
                    
                    var gradient = svg.querySelector("radialGradient");
                    var rect = svg.querySelector(".wbb-tracking-rect");
                    
                    // Mouse tracking
                    function handleMouseMove(e) {
                        var elRect = el.getBoundingClientRect();
                        var relX = ((e.clientX - elRect.left) / elRect.width) * 100;
                        var relY = ((e.clientY - elRect.top) / elRect.height) * 100;
                        
                        gradient.setAttribute("cx", relX + "%");
                        gradient.setAttribute("cy", relY + "%");
                        
                        // Check if mouse is near
                        var centerX = elRect.left + elRect.width / 2;
                        var centerY = elRect.top + elRect.height / 2;
                        var dist = Math.sqrt(Math.pow(e.clientX - centerX, 2) + Math.pow(e.clientY - centerY, 2));
                        var maxDist = Math.max(elRect.width, elRect.height);
                        
                        var opacity = 1 - (dist / maxDist);
                        rect.setAttribute("opacity", Math.max(0, Math.min(1, opacity)));
                    }
                    
                    function handleMouseLeave() {
                        rect.setAttribute("opacity", "0");
                    }
                    
                    el.addEventListener("mousemove", handleMouseMove);
                    el.addEventListener("mouseleave", handleMouseLeave);
                    
                    // Also track parent movements
                    document.addEventListener("mousemove", function(e) {
                        var elRect = el.getBoundingClientRect();
                        var inBounds = e.clientX >= elRect.left - 100 && e.clientX <= elRect.right + 100 &&
                                      e.clientY >= elRect.top - 100 && e.clientY <= elRect.bottom + 100;
                        if (inBounds) handleMouseMove(e);
                    });
                });
            }
            
            // Initialize on load and Elementor events
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initWbbBorderEffects);
            } else {
                initWbbBorderEffects();
            }
            
            // Re-init on Elementor frontend init
            if (typeof elementorFrontend !== "undefined") {
                jQuery(window).on("elementor/frontend/init", function() {
                    elementorFrontend.hooks.addAction("frontend/element_ready/global", initWbbBorderEffects);
                });
            }
        })();
        
//# sourceURL=elementor-frontend-js-after
</script>
