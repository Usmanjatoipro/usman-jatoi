			<style id="wbb-styling-kit-vars">
:root {
    /* WBB Styling Kit - Global Variables */
    --wbb-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    --wbb-radius: 12px;
    --wbb-font: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;
    
    /* Colors */
    --wbb-primary: #6366f1;
    --wbb-secondary: #8b5cf6;
    --wbb-accent: #06b6d4;
    --wbb-text: #0f172a;
    --wbb-text-muted: #64748b;
    --wbb-bg: #ffffff;
    --wbb-surface: #f8fafc;
    
    /* Gradients */
    --wbb-gradient-border: none;
    --wbb-gradient-text: none;
}

/* Gradient Text Utility */
.wbb-gradient-text {
    background: var(--wbb-gradient-text, linear-gradient(135deg, var(--wbb-primary), var(--wbb-secondary)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Gradient Border Utility */
.wbb-gradient-border {
    position: relative;
    background: var(--wbb-bg);
    border-radius: var(--wbb-radius);
}
.wbb-gradient-border::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 2px;
    border-radius: var(--wbb-radius);
    background: var(--wbb-gradient-border, linear-gradient(135deg, var(--wbb-primary), var(--wbb-secondary)));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
}

/* Apply global font */
.wbb-font {
    font-family: var(--wbb-font);
}

/* Apply global shadow */
.wbb-shadow {
    box-shadow: var(--wbb-shadow);
}

/* Apply global radius */
.wbb-rounded {
    border-radius: var(--wbb-radius);
}
