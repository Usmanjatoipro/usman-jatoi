   <script>
        // Select all boxes inside the unique container
        const uniqueBoxes = document.querySelectorAll('.unique-box');

        // Add hover functionality
        uniqueBoxes.forEach(box => {
            box.addEventListener('mouseover', () => {
                uniqueBoxes.forEach(otherBox => {
                    if (otherBox === box) {
                        otherBox.style.flex = '10'; // Expand the hovered box
                    } else {
                        otherBox.style.flex = '1'; // Shrink other boxes
                    }
                });
            });

            box.addEventListener('mouseout', () => {
                // Reset to initial sizes
                document.getElementById('unique-first').style.flex = '1';
                document.getElementById('unique-second').style.flex = '2';
                document.getElementById('unique-third').style.flex = '1';
            });
        });
    </script>

