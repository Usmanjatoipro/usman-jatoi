<link href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" rel="stylesheet">        <style>
        .wbb-rel-services { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
        .wbb-rel-card { background:#fff; border-radius:14px; overflow:hidden; position:relative; box-shadow:0 2px 6px rgba(0,0,0,0.08); text-decoration:none; color:inherit; display:flex; flex-direction:column; transition:transform 0.3s; }
        .wbb-rel-card:hover { transform:translateY(-5px); }
        .wbb-rel-card::before {
            content:""; position:absolute; top:0; left:0; right:0; bottom:0; padding:2px; border-radius:14px;
            background:linear-gradient(270deg, red, orange, yellow, green, cyan, blue, violet, red); background-size:400% 400%;
            -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: destination-out; mask-composite: exclude;
            animation: wbbRainbow 6s linear infinite; opacity:0; transition:opacity 0.3s; pointer-events:none;
        }
        .wbb-rel-card:hover::before { opacity:1; }
        @keyframes wbbRainbow { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }
        .wbb-rel-thumb img { width:100%; height:180px; object-fit:cover; display:block; }
        .wbb-rel-body { padding:15px; }
        .wbb-rel-body h3 { margin:0 0 10px; font-size:18px; }

        .wbb-products-grid { display:flex; flex-wrap:wrap; gap:15px; }
        .wbb-prod-card { flex:0 0 220px; border:1px solid #eee; padding:10px; border-radius:8px; }
        .wbb-prod-thumb img { width:100%; height:auto; }
        .wbb-btn { display:inline-block; padding:5px 10px; background:#eee; text-decoration:none; border-radius:4px; font-size:12px; margin-top:5px; }
