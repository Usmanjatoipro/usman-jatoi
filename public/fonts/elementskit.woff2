<style id="wp-custom-css">
/* Headings */
h1, h2, h3, h4, h5, h6 {
    font-family: "Helvetica", sans-serif;
    font-weight: normal !important;
    color: #222;
}

h1 { font-size: 36px; }
h2 { font-size: 30px; }
h3 { font-size: 22px; !important }
h4 { font-size: 20px; }
h5 { font-size: 18px; }
h6 { font-size: 16px; }


h3 {
  font-size: 18px !important;
  line-height: 1.4;
  margin-bottom: 0.5em;
  font-weight: 600 !important;
}



/* Invert colors for selected text with rounded corners */
::selection {
  background-color: black; /* Set a background color to enable contrast */
  color: white;            /* Set the text color */
  mix-blend-mode: difference; /* Inverts colors for the selected area */
}

/* For Webkit browsers (e.g., Chrome, Safari) */
::-webkit-selection {
  background-color: black;
  color: white;
  mix-blend-mode: difference;
}


/* General styles for the entire audio player controls */
.plyr__controls {
    background-color: black; /* Set background to black */
    color: white; /* Text color white */
}

/* Controls items, such as buttons for play, volume, settings */
.plyr__controls__item {
    color: white; /* Default color for controls */
    background-color: black; /* Default background color */
}

/* Play/Pause button */
.plyr__control {
    color: white; /* Default color for control icons (e.g., play/pause) */
    background-color: black; /* Default background color for play/pause buttons */
    border: none; /* Remove any borders */
}

/* Hover effects for controls */
.plyr__control:hover {
    color: black !important; /* On hover, icon color turns black */
    background-color: white !important; /* On hover, background turns white */
}

/* Progress bar buffer (unfilled section) */
.plyr__progress__buffer {
    background-color: white; /* Set buffer bar to white */
}

/* Progress bar played section */
.plyr__progress__played {
    background-color: white; /* Set played section to white */
}

/* Time display (duration) */
.plyr__time--duration {
    color: white; /* Set duration text color to white */
}

/* Volume controls */
.plyr__volume {
    color: white; /* Volume label text color white */
}

/* Volume input (range slider) */
.plyr__volume input {
    background-color: black; /* Set volume slider background to black */
    color: white; /* Set volume slider color to white */
}

/* Mute/Unmute button */
.plyr__control[data-plyr="mute"] {
    color: white; /* Mute/unmute button color */
    background-color: black; /* Mute/unmute button background color */
}

/* Hover effects for Mute/Unmute button */
.plyr__control[data-plyr="mute"]:hover {
    color: black; /* Mute/unmute icon color turns black on hover */
    background-color: white; /* Background turns white on hover */
}

/* Menu and settings button */
.plyr__menu button {
    color: white; /* Settings button color */
    background-color: black; /* Settings button background color */
}

/* Hover effects for Settings button */
.plyr__menu button:hover {
    color: black; /* Settings icon color turns black on hover */
    background-color: white; /* Background turns white on hover */
}

/* Tooltip styles for the progress bar */
.plyr__tooltip {
    background-color: black; /* Set tooltip background to black */
    color: white; /* Set tooltip text to white */
}

/* Active/Not Active button states */
.plyr__control--pressed {
    background-color: black !important;
    color: white !important; /* Ensure active button state is black and white */
}

/* Menu items (like settings and quality) */
.plyr__menu__container button {
    background-color: black; /* Default menu item background color */
    color: white; /* Default menu item text color */
}

/* Hover effects for menu items */
.plyr__menu__container button:hover {
    background-color: white; /* Menu item background turns white on hover */
    color: black; /* Text color turns black on hover */
}

/* Back button for menu */
.plyr__control--back {
    background-color: black; /* Default back button background color */
    color: white; /* Default back button text color */
}

/* Hover effects for Back button */
.plyr__control--back:hover {
    background-color: white; /* Background turns white on hover */
    color: black; /* Text color turns black on hover */
}

/* Settings speed control menu */
.plyr__control[aria-checked="true"] {
    background-color: black; /* Selected items should have black background */
    color: white; /* Set text to white */
}

/* Hover effects for speed controls */
.plyr__control[aria-checked="true"]:hover {
    background-color: white; /* Background turns white on hover */
    color: black; /* Text color turns black on hover */
}

/* Global Font */
body {
    font-family: "Helvetica", sans-serif;
    color: #333;
}

#powered_by_triangle,
#powered_by_footer,
#powered_by_prefooter,
#branding-free {
    display: none !important;
  }





/* Rainbow Btns Effect */
.rainbow-border {
  position: relative;
  border: 1px solid transparent;
  border-radius: 120px;
  background-origin: border-box;
  background-clip: content-box, border-box;
  background-image:
    linear-gradient(white, white), /* Inner content background */
    linear-gradient(45deg, #ff6ec4, #7873f5, #1fd1f9, #ff6ec4); /* Outer border gradient */
  animation: gradientBorder 6s linear infinite;
  padding: 1px; /* Padding for border space */
  overflow: hidden;
  transition: box-shadow 0.3s ease;
  display: inline-block;
}

/* Force internal padding with a wrapper element */
.rainbow-border > .btn-content {
  padding: 15px 40px !important;
  border-radius: 120px;
  background: transparent;
  display: inline-block;
  z-index: 1;
  position: relative;
}

/* Glassy moving reflection on hover */
.rainbow-border::after {
  content: "";
  position: absolute;
  top: 0;
  left: -150%;
  width: 50%;
  height: 100%;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.4) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: skewX(-25deg);
  transition: left 2s ease;
  border-radius: 120px;
  pointer-events: none;
  mix-blend-mode: screen;
}

/* On hover, slide the reflection across the border */
.rainbow-border:hover::after {
  left: 150%;
}

/* Gradient border animation */
@keyframes gradientBorder {
  0% {
    background-image:
      linear-gradient(white, white),
      linear-gradient(45deg, #ff6ec4, #7873f5, #1fd1f9, #ff6ec4);
  }
  50% {
    background-image:
      linear-gradient(white, white),
      linear-gradient(45deg, #1fd1f9, #ff6ec4, #7873f5, #1fd1f9);
  }
  100% {
    background-image:
      linear-gradient(white, white),
      linear-gradient(45deg, #ff6ec4, #7873f5, #1fd1f9, #ff6ec4);
  }
}




/* Header rainbow animated border */
.header2,
.header3 {
  position: relative;
}

/* Add the rainbow animated border */
.header1::after,
.header2::after,
.header3::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  height: 2px;
  width: 100%;
  background: linear-gradient(
    90deg,
    #ff6ec4,
    #7873f5,
    #1fd1f9,
    #ff6ec4
  );
  background-size: 300% 100%;
  animation: rainbowBorderMove 6s linear infinite;
}

/* Animation */
@keyframes rainbowBorderMove {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}


.custom-breadcrumb {
	color:white !important;
}


.breadcrumb-wrapper {
    text-align: center;
    padding: 15px 10px;
}

.breadcrumb {
    display: inline-block;
    font-size: 16px;
}

.breadcrumb-home,
.breadcrumb-parent,
.breadcrumb-category,
.breadcrumb-current,
.breadcrumb-search,
.breadcrumb-separator {
    color: white !important;
    text-decoration: none;
}

/* Optional: Style each part differently */
.breadcrumb-home { color: #ffffff; }
.breadcrumb-parent { color: #eeeeee; }
.breadcrumb-category { color: #dddddd; }
.breadcrumb-current { color: #cccccc; font-weight: bold; }
.breadcrumb-separator { color: #bbbbbb; }
.breadcrumb-search { color: #ffffff; font-style: italic; }

.breadcrumb a:hover {
    text-decoration: underline;
}

@media screen and (max-width: 600px) {
    .breadcrumb {
        font-size: 14px;
        word-wrap: break-word;
    }
}

.single_add_to_cart_button button alt {
	padding-top: 10px;
	padding-bottom: 10px;
}

</style>
</head>
