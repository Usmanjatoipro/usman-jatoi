<style id="wbb-ultimate-category-grid-inline-css">

        .ucg-wrapper{font-family:system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial; color:#111;}
        .ucg-main-title{margin:18px 0 8px; font-size:1.35rem;}
        .ucg-main-title a{text-decoration:none;color:inherit;}
        .ucg-header-row{display:flex;justify-content:space-between;align-items:center;}
        .ucg-grid{display:grid; grid-template-columns: repeat(3, 1fr); gap:14px; margin:12px 0 8px;}
        @media (max-width:900px){ .ucg-grid{grid-template-columns: repeat(2,1fr);} }
        @media (max-width:520px){ .ucg-grid{grid-template-columns: 1fr;} }
        .ucg-block{background:#fff; border:1px solid #eee; padding:14px; border-radius:10px; box-shadow: 0 1px 0 rgba(0,0,0,0.03); transition: transform .16s ease, box-shadow .16s ease; display:flex; align-items:center; justify-content:space-between; gap:10px;}
        .ucg-block:hover{ transform: translateY(-6px); box-shadow: 0 10px 20px rgba(0,0,0,0.06); }
        .ucg-block .ucg-name{font-weight:600; font-size:0.98rem; text-decoration:none; color: #111;}
        .ucg-count{opacity:0.7; font-size:0.9rem; white-space:nowrap; margin-left:8px;}
        .ucg-row-end{display:flex; justify-content:flex-end; margin-top:0; margin-bottom:0;}
        .ucg-wizard-btn{display:inline-block; text-decoration:none; padding:9px 14px; border-radius:9px; border:1px solid #111; background:#fff; color:#111; font-weight:600; box-shadow: none; transition: transform .12s ease, box-shadow .12s ease; }
        .ucg-wizard-btn:hover{ transform:translateY(-3px); box-shadow:0 8px 18px rgba(0,0,0,0.06); }
        
/*# sourceURL=wbb-ultimate-category-grid-inline-css */
</style>
