        <style>.wbb-token { display: inline !important; color: inherit !important; }</style>
        <script>
        (function(){
            'use strict';
            function _getLS(k){ try { return localStorage.getItem(k); } catch(e){ return null;} }
            function _setLS(k,v){ try{ localStorage.setItem(k,v);}catch(e){} }
            function _getSS(k){ try { return sessionStorage.getItem(k); } catch(e){ return null;} }
            function _setSS(k,v){ try{ sessionStorage.setItem(k,v);}catch(e){} }
            function _cookieRead(name){
                var m = document.cookie.match(new RegExp('(^|;\\s*)' + name + '=([^;]*)'));
                return m ? decodeURIComponent(m[2]) : null;
            }
            function _cookieWrite(name, value, days){
                days = days || 365;
                var d = new Date(); d.setTime(d.getTime() + days*24*60*60*1000);
                document.cookie = name + '=' + encodeURIComponent(value) + ';path=/;expires=' + d.toUTCString();
            }

            function parseUA(ua){
                ua = ua || navigator.userAgent || '';
                var os = 'Unknown', browser = 'Unknown', device = 'Desktop';
                if (/android/i.test(ua)) os = 'Android';
                else if (/iphone|ipad|ipod/i.test(ua)) os = 'iOS';
                else if (/windows phone/i.test(ua)) os = 'Windows Phone';
                else if (/windows/i.test(ua)) os = 'Windows';
                else if (/mac os x|macintosh/i.test(ua)) os = 'macOS';
                else if (/linux/i.test(ua)) os = 'Linux';

                if (/chrome\/\d+/i.test(ua) && !/edge|edg|opr|opera/i.test(ua)) browser = 'Chrome';
                else if (/safari/i.test(ua) && !/chrome|crios|opr|opera/i.test(ua)) browser = 'Safari';
                else if (/firefox/i.test(ua)) browser = 'Firefox';
                else if (/edg|edge/i.test(ua)) browser = 'Edge';

                if (/mobi|android|touch|iphone|ipad/i.test(ua)) device = 'Mobile';
                return { os: os, browser: browser, device: device, ua: ua };
            }

            function collectSignals(callback){
                var stored = _getLS('wbb_personal_cache');
                if (stored) { try { callback(JSON.parse(stored)); return; } catch(e){} }

                var uaInfo = parseUA(navigator.userAgent);
                var d = new Date();
                var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
                var localTime = d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                
                // Visits
                var visits = parseInt(_getLS('wbb_visits') || '0', 10) || 0;
                var lastVisit = _getLS('wbb_last_visit');
                var nowIso = d.toISOString();
                
                if (!lastVisit || (d - new Date(lastVisit) > 30*60*1000)) {
                    visits++;
                    _setLS('wbb_visits', visits);
                }
                _setLS('wbb_last_visit', nowIso);

                var out = {
                    language: (navigator.language || '').split('-')[0],
                    timezone: tz,
                    local_time: localTime,
                    os: uaInfo.os,
                    browser: uaInfo.browser,
                    device: uaInfo.device,
                    visits_count: visits,
                    is_returning: visits > 1 ? '1' : '0'
                };

                // Save
                _setLS('wbb_personal_cache', JSON.stringify(out));
                _cookieWrite('wbb_personal', JSON.stringify(out), 365);
                callback(out);
            }

            function replaceTokens(data) {
                if (!data) return;
                var els = document.querySelectorAll('.wbb-token');
                els.forEach(function(el){
                    var name = el.getAttribute('data-name');
                    var fallback = el.getAttribute('data-fallback') || '';
                    var val = data[name];
                    
                    // Specific logic for greeting if not present
                    if (name === 'greeting' && !val) {
                         var h = new Date().getHours();
                         if (h < 12) val = 'Good morning';
                         else if (h < 18) val = 'Good afternoon';
                         else val = 'Good evening';
                    }
                    
                    if (val === undefined || val === null || val === '') val = fallback;
                    el.textContent = val;
                });
            }

            collectSignals(replaceTokens);
        })();
        </script>
                <!-- WBB QR Modal -->
        <div id="wbbQRModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); justify-content:center; align-items:center; z-index:99999;">
            <div style="background:#fff; color:#000; padding:20px; border-radius:12px; text-align:center; position:relative; max-width:300px; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
                <span id="wbbCloseQR" style="position:absolute; top:8px; right:12px; cursor:pointer; font-size:18px; color:#333;">&times;</span>
                <h3 style="margin:0 0 15px; font-size:18px;">Scan this QR</h3>
                <div id="wbbQRCode" style="margin-bottom:15px;"></div>
                <button id="wbbDownloadQR" style="padding:8px 15px; border:none; border-radius:6px; background:#000; color:#fff; cursor:pointer; font-size:14px;">Download QR</button>
            </div>
        </div>
        
        <!-- QRCode.js -->
        <script defer src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
        
        <script>
        (function(){
            document.addEventListener("click", function(e) {
                // Check if clicked element matches trigger or is inside a trigger
                var target = e.target.closest('a[href="#show-qr"], .wbb-qr-trigger');
                
                if(target) {
                    e.preventDefault();
                    var modal = document.getElementById("wbbQRModal");
                    var container = document.getElementById("wbbQRCode");
                    if (!modal || !container) return;
                    
                    modal.style.display = "flex";
                    container.innerHTML = "";
                    
                    // Simple check if library is loaded
                    if (typeof QRCode !== 'undefined') {
                        new QRCode(container, {
                            text: window.location.href,
                            width: 200,
                            height: 200,
                            colorDark : "#000000",
                            colorLight : "#ffffff",
                            correctLevel : QRCode.CorrectLevel.H
                        });
                    } else {
                        container.innerHTML = "Loading library...";
                        setTimeout(function(){
                             if(typeof QRCode !== 'undefined') {
                                container.innerHTML = "";
                                new QRCode(container, { text: window.location.href, width: 200, height: 200 });
                             }
                        }, 1000);
                    }
                }
            });

            document.addEventListener("DOMContentLoaded", function(){
                var modal = document.getElementById("wbbQRModal");
                if(!modal) return;
                
                var closeBtn = document.getElementById("wbbCloseQR");
                if(closeBtn) closeBtn.onclick = function() { modal.style.display="none"; };
                
                modal.addEventListener("click", function(e){ 
                    if(e.target === modal) modal.style.display="none"; 
                });
                
                var dlBtn = document.getElementById("wbbDownloadQR");
                if(dlBtn) dlBtn.onclick = function() {
                    var canvas = document.querySelector("#wbbQRCode canvas");
                    var img = document.querySelector("#wbbQRCode img"); // QRCode.js fallback
                    var url = "";
                    
                    if(canvas) url = canvas.toDataURL("image/png");
                    else if(img) url = img.src;
                    
                    if(!url) return;
                    
                    var link = document.createElement("a");
                    var safeTitle = document.title.replace(/[^a-z0-9]+/gi, "_").toLowerCase() || "qrcode";
                    link.download = safeTitle + ".png";
                    link.href = url;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                };
            });
        })();
        </script>
                <!-- WBB Smart Tools Assets -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js"></script>
        
        <!-- QR Modal HTML -->
        <div id="wbb-qr-modal" class="wbb-tools-modal">
            <div class="wbb-tools-model-content">
                <span class="wbb-tools-close">&times;</span>
                <h3>Scan this QR</h3>
                <canvas id="wbb-qr-target" class="wbb-qr-canvas"></canvas>
                <button id="wbb-download-qr" style="margin-top:15px; padding:8px 12px; border:none; border-radius:8px; background:#000; color:#fff; cursor:pointer;">Download QR</button>
                <p style="font-size:12px; color:#666; margin-top:10px;">Scan to read on mobile</p>
            </div>
        </div>
        <div id="wbb-toast" class="wbb-toast">Link Copied to Clipboard!</div>

        <style>
            .wbb-tools-modal { display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.7); align-items: center; justify-content: center; }
            .wbb-tools-modal.active { display: flex; }
            .wbb-tools-model-content { background-color: #fff; margin: auto; padding: 25px; border-radius: 12px; width: 90%; max-width: 300px; text-align: center; position: relative; box-shadow: 0 4px 20px rgba(0,0,0,0.2); }
            .wbb-tools-close { color: #aaa; position: absolute; right: 12px; top: 8px; font-size: 18px; cursor: pointer; }
            .wbb-tools-close:hover { color: #000; }
            .wbb-qr-canvas { margin: 15px auto; display: block; max-width: 100%; }
            .wbb-toast { visibility: hidden; min-width: 250px; margin-left: -125px; background-color: #333; color: #fff; text-align: center; border-radius: 4px; padding: 12px; position: fixed; z-index: 10000; left: 50%; bottom: 30px; font-size: 14px; opacity: 0; transition: opacity 0.3s; }
            .wbb-toast.show { visibility: visible; opacity: 1; }
        </style>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
            // QR Logic
            const modal = document.getElementById('wbb-qr-modal');
            const close = modal.querySelector('.wbb-tools-close');
            const qrCanvas = document.getElementById('wbb-qr-target');
            const downloadBtn = document.getElementById('wbb-download-qr');
            let qr = null;

            window.wbbShowQR = function() {
                modal.classList.add('active');
                if(!qr) {
                    qr = new QRious({
                        element: qrCanvas,
                        value: window.location.href,
                        size: 200,
                        level: 'H'
                    });
                }
            };

            // Trigger on hash link click
            document.addEventListener("click", function(e) {
                if(e.target.closest('a[href="#show-qr"]')) {
                    e.preventDefault();
                    window.wbbShowQR();
                }
            });
            
            close.onclick = function() { modal.classList.remove('active'); };
            window.onclick = function(e) { if(e.target == modal) modal.classList.remove('active'); };

            // Download Logic
            downloadBtn.onclick = function() {
                const link = document.createElement("a");
                let safeTitle = document.title.replace(/[^a-z0-9]+/gi, "_").toLowerCase() || "qrcode";
                link.download = safeTitle + ".png";
                link.href = qrCanvas.toDataURL("image/png");
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            };

            // Copy Link (Global helper)
            window.wbbCopyLink = function() {
                navigator.clipboard.writeText(window.location.href).then(function() {
                    const toast = document.getElementById('wbb-toast');
                    toast.className = "wbb-toast show";
                    setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 3000);
                });
            };

            // Print
            window.wbbPrintPage = function() {
                window.print();
            };
        });
        </script>
