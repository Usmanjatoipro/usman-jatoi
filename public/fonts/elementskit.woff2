<script id="jquery-migrate-js" src="https://usmanjatoi.com/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1"></script>
<script id="jquery-js-after">
jQuery(document).ready(function($) {
            const tooltip = $('<div id="wbb-dynamic-tooltip"><img><div class="wbb-dt-text"></div></div>').appendTo('body');
            let ajaxCache = {};

            function showTooltip(e, content) {
                const { title, desc, image } = content;
                
                // Content
                const imgEl = tooltip.find('img');
                if(image) { imgEl.attr('src', image).show(); } else { imgEl.hide(); }
                tooltip.find('.wbb-dt-text').html('<strong>' + title + '</strong><br>' + desc);
                
                tooltip.fadeIn(150);
                positionTooltip(e);
            }

            function positionTooltip(e) {
                const w = $(window).width();
                const h = $(window).height();
                const tW = tooltip.outerWidth();
                const tH = tooltip.outerHeight();
                
                let top = e.pageY + 20;
                let left = e.pageX + 20;

                // Smart Edge Detection
                if (left + tW > w) { // Overflow Right
                    left = e.pageX - tW - 20; 
                }
                if (top + tH > $(document).scrollTop() + h) { // Overflow Bottom
                    top = e.pageY - tH - 20;
                }

                tooltip.css({ top: top, left: left });
            }

            // Detect internal links
            $('a').on('mouseenter', function(e) {
                const link = $(this);
                const url = link.attr('href');
                
                // Basic filters
                if (!url || url.startsWith('#') || url.indexOf(window.location.hostname) === -1 || link.hasClass('no-tooltip')) return;
                
                // Show instant if cached
                if (ajaxCache[url]) {
                    showTooltip(e, ajaxCache[url]);
                    return;
                }

                // Fetch
                $.post('https://usmanjatoi.com/wp-admin/admin-ajax.php', { 
                    action: 'wbb_get_tooltip', 
                    url: url,
                    nonce: '71498b4122'
                }, function(res) {
                    if (res.success) {
                        ajaxCache[url] = res.data;
                        // Only show if still hovering
                        if (link.is(':hover')) {
                            showTooltip(e, res.data);
                        }
                    }
                });
            });

            $(document).on('mousemove', function(e) {
                if (tooltip.is(':visible')) {
                    positionTooltip(e);
                }
            });

            $('a').on('mouseleave', function() {
                tooltip.hide();
            });
        });
        
//# sourceURL=jquery-js-after
</script>
