                <script>
        (function(){
            try {
                // Connection type
                let conn = (navigator.connection && navigator.connection.effectiveType) ? navigator.connection.effectiveType : '';
                if(typeof conn === "string" && conn) {
                    document.cookie = "vibe_connection=" + conn + "; path=/";
                }
    
                // Local time (friendly format)
                let d = new Date();
                let localtime = d.toLocaleString([], {month:'numeric', day:'numeric', year:'2-digit', hour:'2-digit', minute:'2-digit'});
                document.cookie = "vibe_localtime=" + encodeURIComponent(localtime) + "; path=/";

                // Vibe Visits (JS Handling to avoid Header issues)
                let visits = document.cookie.replace(/(?:(?:^|.*;\s*)vibe_visits\s*\=\s*([^;]*).*$)|^.*$/, "$1");
                if(!visits) visits = 0;
                visits = parseInt(visits) + 1;
                document.cookie = "vibe_visits=" + visits + "; path=/; max-age=31536000";
            } catch(e){}
        })();
        </script>
